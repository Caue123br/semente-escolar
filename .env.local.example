# PostgreSQL exclusivo do Semente (somente servidor)
# Na VPS, use o cluster dedicado em 127.0.0.1:5433 e mantenha este arquivo 0600.
DATABASE_URL=postgresql://semente_runtime:TROQUE_ESTA_SENHA@127.0.0.1:5433/semente_prod
DATABASE_MIGRATION_URL=postgresql://semente_migrator:TROQUE_ESTA_SENHA@127.0.0.1:5433/semente_prod
DATABASE_MIGRATION_ROLE=semente_owner
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=semente-web
DATABASE_SSL=false

# Esta implantação usa um banco exclusivo para uma escola.
SCHOOL_ID=default
SESSION_TTL_HOURS=12

# Diretório persistente, fora dos releases da aplicação.
UPLOADS_DIR=/srv/semente/shared/uploads

# Gere com: openssl rand -base64 48
PAIS_SESSION_SECRET=
WHATSAPP_WEBHOOK_SECRET=

# Recursos sensíveis permanecem desligados até configuração específica.
ENABLE_PARENT_PORTAL=false
ENABLE_DEMO_SEED=false

# Botão opcional de carga única de dados fictícios no Cockpit.
# Em produção, habilite somente durante a avaliação e limite a um diretor.
ENABLE_ADMIN_DEMO_SEED=false
DEMO_SEED_ALLOWED_EMAIL=

NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO
