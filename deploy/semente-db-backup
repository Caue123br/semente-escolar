#!/usr/bin/env bash
set -Eeuo pipefail
set +x
umask 077

backup_dir=/srv/semente/shared/backups
database_name=semente_prod
cluster_port=5433
stamp=$(date -u +%Y%m%dT%H%M%SZ)

install -d -o root -g root -m 0700 "${backup_dir}"
exec 9>/run/lock/semente-db-backup.lock
flock -n 9 || exit 0

database_tmp=$(mktemp "${backup_dir}/.database-${stamp}.XXXXXX")
globals_tmp=$(mktemp "${backup_dir}/.globals-${stamp}.XXXXXX")
config_tmp=$(mktemp "${backup_dir}/.config-${stamp}.XXXXXX")

cleanup() {
  rm -f "${database_tmp}" "${globals_tmp}" "${config_tmp}"
}
trap cleanup EXIT

sudo -u postgres pg_dump \
  -h /var/run/postgresql \
  -p "${cluster_port}" \
  -d "${database_name}" \
  --format=custom \
  --no-password \
  > "${database_tmp}"

sudo -u postgres pg_dumpall \
  -h /var/run/postgresql \
  -p "${cluster_port}" \
  --globals-only \
  --no-password \
  > "${globals_tmp}"

tar -czf "${config_tmp}" \
  /etc/postgresql/16/semente \
  /etc/semente \
  /etc/systemd/system/semente.service \
  /srv/semente/current/db/migrations

pg_restore --list "${database_tmp}" >/dev/null

database_final="${backup_dir}/database-${stamp}.dump"
globals_final="${backup_dir}/globals-${stamp}.sql"
config_final="${backup_dir}/config-${stamp}.tar.gz"
mv "${database_tmp}" "${database_final}"
mv "${globals_tmp}" "${globals_final}"
mv "${config_tmp}" "${config_final}"
sha256sum "${database_final}" "${globals_final}" "${config_final}" \
  > "${backup_dir}/checksums-${stamp}.sha256"

find "${backup_dir}" -maxdepth 1 -type f -mtime +7 -delete
trap - EXIT
echo "Backup local Semente concluído: ${stamp}"
